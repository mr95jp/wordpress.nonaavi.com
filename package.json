{
  "name": "wordpress-noanavi-com",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.7",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "sync:articles": "node scripts/sync-articles.mjs",
    "check:site": "node scripts/check-site.mjs",
    "og": "node scripts/make-og.mjs",
