    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2",
    "remark-cjk-friendly": "^2.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "wrangler": "^4.131.2"
