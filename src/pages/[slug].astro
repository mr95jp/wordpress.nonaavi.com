---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { hubOf } from '../lib/hubs';
import { OPERATOR_NAME, SITE_NAME, formatDate, isoDate } from '../lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry, articles } }));
}

const { entry, articles } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

const hub = hubOf(entry.id);
if (!hub) throw new Error(`${entry.id} がどのハブにも属していません（src/lib/hubs.ts）`);

// 結論ボックスは改行を <br> にするため set:html で出す。本文の ?> や < が HTML として解釈されないよう先に逃がす
const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const toc = headings.filter((h) => h.depth === 2 && !h.text.startsWith('再現手順'));

const bySlug = new Map(articles.map((a) => [a.id, a]));
const relatedSlugs = data.related ?? hub.articles.filter((s) => s !== entry.id).slice(0, 4);
const related = relatedSlugs.map((s) => bySlug.get(s)).filter((a) => a !== undefined);

const url = new URL(`/${entry.id}/`, Astro.site).href;
const hubUrl = new URL(`/topics/${hub.id}/`, Astro.site).href;
const modified = data.updated ?? data.verified;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: data.title,
    description: data.description,
    datePublished: isoDate(data.published ?? data.verified),
    dateModified: isoDate(modified),
    mainEntityOfPage: url,
    author: { '@type': 'Person', name: OPERATOR_NAME, url: new URL('/about/', Astro.site).href },
    publisher: { '@type': 'Organization', name: SITE_NAME, url: Astro.site?.href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: hub.label, item: hubUrl },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
];
---

<Base
  title={data.seo_title}
  description={data.description}
  noindex={data.status === 'draft'}
  ogType="article"
  jsonLd={jsonLd}
>
  <nav class="breadcrumb" aria-label="パンくずリスト">
    <a href="/">トップ</a> › <a href={`/topics/${hub.id}/`}>{hub.label}</a>
  </nav>

  <article class="article">
    <header>
      <h1>{data.title}</h1>
      <p class="verified">
        <span class="badge">実測</span>
        <time datetime={isoDate(data.verified)}>{formatDate(data.verified)}</time> に検証
        {data.env && <span class="env">{data.env}</span>}
      </p>
    </header>

    {
      data.summary && (
        <aside class="summary">
          <p class="summary-label">この記事の結論</p>
          <p set:html={escapeHtml(data.summary.trim()).replace(/\n/g, '<br>')} />
        </aside>
      )
    }

    {
      toc.length > 2 && (
        <nav class="toc" aria-label="目次">
          <p class="toc-label">目次</p>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="related">
        <h2>次に疑うこと</h2>
        <ul class="cards">
          {related.map((a) => (
            <li>
              <a href={`/${a.id}/`}>
                <span class="card-title">{a.data.title}</span>
                <span class="card-desc">{a.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
        <p>
          <a href={`/topics/${hub.id}/`}>「{hub.label}」の記事をすべて見る</a>
        </p>
      </section>
    )
  }
</Base>
