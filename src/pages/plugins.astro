---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('indexes', 'plugins');
if (!entry) throw new Error('src/content/indexes/plugins.md がありません');
const { Content } = await render(entry);
---

<Base
  title="プラグイン名から探す｜WordPress 不具合の原因"
  description="Contact Form 7、SiteGuard、All-in-One WP Migration、キャッシュ系、セキュリティ系など、プラグイン名から不具合の本当の原因と対処法の記事を引ける索引です。"
>
  <nav class="breadcrumb" aria-label="パンくずリスト"><a href="/">トップ</a> › プラグイン名から探す</nav>
  <div class="prose">
    <Content />
  </div>
</Base>
