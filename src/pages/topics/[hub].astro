---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { HUBS, type Hub } from '../../lib/hubs';

export function getStaticPaths() {
  return HUBS.map((hub) => ({ params: { hub: hub.id }, props: { hub } }));
}

const { hub } = Astro.props as { hub: Hub };
const bySlug = new Map((await getCollection('articles')).map((a) => [a.id, a]));

const articles = hub.articles.map((slug) => {
  const a = bySlug.get(slug);
  if (!a) throw new Error(`hubs.ts の ${hub.id} にある ${slug} が記事に存在しません`);
  return a;
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: hub.title,
    description: hub.description,
    url: new URL(`/topics/${hub.id}/`, Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: articles.map((a, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(`/${a.id}/`, Astro.site).href,
        name: a.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: hub.label, item: new URL(`/topics/${hub.id}/`, Astro.site).href },
    ],
  },
];
---

<Base title={hub.seoTitle} description={hub.description} jsonLd={jsonLd}>
  <nav class="breadcrumb" aria-label="パンくずリスト"><a href="/">トップ</a> › {hub.label}</nav>

  <h1>{hub.title}</h1>
  <p class="lead">{hub.lead}</p>

  <section>
    <h2>見えている症状から選ぶ</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>見えているもの</th><th>まず疑う</th></tr></thead>
        <tbody>
          {
            hub.rows.map((row) => (
              <tr>
                <td><a href={`/${row.slug}/`}>{row.see}</a></td>
                <td>{row.suspect}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p>直前にやった操作から探す場合は <a href="/symptoms/#直前にやったことから引く">直前にやったことから引く</a> へ。</p>
  </section>

  <section>
    <h2>このテーマの記事</h2>
    <ul class="cards">
      {
        articles.map((a) => (
          <li>
            <a href={`/${a.id}/`}>
              <span class="card-title">{a.data.title}</span>
              <span class="card-desc">{a.data.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
