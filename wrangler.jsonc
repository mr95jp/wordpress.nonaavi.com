// 静的サイトとして Cloudflare Workers の静的アセットで配信する（アダプター不要）
// https://docs.astro.build/ja/guides/deploy/cloudflare/
//
// このファイルを消さないこと。無いと Workers Builds が「astro add cloudflare」を自動で実行し、
// アダプターが astro.config.mjs の redirects を _redirects に書き足して deploy が失敗する。
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Cloudflare 側の Worker 名に合わせる（違うとビルドのたびに警告と修正 PR が出る）
	"name": "wordpress-nonaavi-com",
	"compatibility_date": "2026-09-11",
	"assets": {
		"directory": "./dist",
		// 存在しない URL には dist/404.html を 404 で返す
		"not_found_handling": "404-page",
		// /slug/ → dist/slug/index.html。astro.config.mjs の trailingSlash: 'always' と合わせる
		"html_handling": "auto-trailing-slash"
	}
}
